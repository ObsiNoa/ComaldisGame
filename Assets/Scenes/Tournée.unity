      propertyPath: m_text
      value: "Infos : \n\nInfos compl\xE9mentaires sur la livraison. \nPeut contenir
        des demandes sp\xE9ciales sur la livraison tel que: la r\xE9cup\xE9ration
        des palettes Europe."
      objectReference: {fileID: 0}
    - target: {fileID: 3527400395135851766, guid: 761789d94491d2041a0ea2720442c017, type: 3}
