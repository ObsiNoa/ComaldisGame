    - target: {fileID: 6634590357651477411, guid: 761789d94491d2041a0ea2720442c017, type: 3}
      propertyPath: m_text
      value: "Infos : \n\nSi la ligne est gris\xE9, il s'agit d'une ramasse.\nLa
        colone livraison sert donc \xE0 indiqu\xE9 o\xF9 vous aller pour faire la
        ramasse."
      objectReference: {fileID: 0}
    - target: {fileID: 7451059853860643814, guid: 761789d94491d2041a0ea2720442c017, type: 3}
